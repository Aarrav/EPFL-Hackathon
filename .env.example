# Copy this file to .env and adjust values for your hardware.

# Robot and camera
ROBOT_PORT=COM3
SO101_PORT=COM5
ROBOT_ID=so100
CAMERA_INDEX=1
FRONT_CAMERA_INDEX=0
WRIST_CAMERA_INDEX=1
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
SO101_URDF_PATH=hardware/urdf/SO101/so101_new_calib.urdf

# Vision assets
LEHARVESTER_DATA_DIR=data
YOLO_MODEL_PATH=data/yolo/my_model.pt
CAPTURED_IMAGES_DIR=data/local_captures
FRUIT_CLASSES=red_fruit,yellow_fruit,green_fruit
DETECTION_CONFIDENCE=0.5

# Motion prototype values
GRIPPER_OPEN=0
GRIPPER_CUT=50
GRIPPER_DROP=0

# Tactile gripper GUI
GRIPPER_SERIAL_PORT=/dev/cu.usbmodem5AE60550891
GRIPPER_BAUD_RATE=1000000
GRIPPER_SERVO_ID=254
GRIPPER_GUI_OPEN=2500
GRIPPER_GUI_CLOSED_LIMIT=1750
GRIPPER_MAX_PRESSURE_CAP=180

# Dataset capture
CAPTURE_TOTAL_IMAGES=100
CAPTURE_INTERVAL_SECONDS=5

# Local policy checkpoints for demo and inference helpers
LEHARVESTER_MODELS_DIR=models
ACT_POLICY_PATH=models/my_act_policy
SMOLVLA_POLICY_PATH=models/my_smolvla_policy
POLICY_TO_TEST=act
POLICY_IMAGE_KEY=observation.images.laptop
POLICY_TASK=pick the red fruit
POLICY_TARGET_IMAGE_WIDTH=224
POLICY_TARGET_IMAGE_HEIGHT=224
POLICY_STATE=0.0,-0.5,1.2,0.0,0.5,0.0,1.0
DEMO_DEFAULT_DURATION_SECONDS=30

# ESP32 dashboard and Telegram bridge
ESP32_WS_URL=ws://10.183.143.188/ws
FARM_NAME=LeRobot Harvester
TELEGRAM_DRY_RUN=1
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
STATUS_INTERVAL_SECONDS=7200
GRIPPER_STUCK_SECONDS=30
NO_ACTIVITY_SECONDS=1800
RECONNECT_SECONDS=5
STALE_DATA_SECONDS=15
ALERT_REPEAT_SECONDS=3600
COMMAND_POLL_SECONDS=5
TELEGRAM_TIMEOUT_SECONDS=15

# Optional weather alerts through Open-Meteo.
FARM_LAT=
FARM_LON=
RAIN_PROBABILITY_THRESHOLD=70
RAIN_LOOKAHEAD_HOURS=2
WEATHER_CHECK_SECONDS=1800
